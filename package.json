{
  "name": "fonteditor-core",
  "version": "3.0.0",
  "description": "fonts (ttf, woff, woff2, eot, svg, otf) parse, write, transform, glyph adjust.",
  "keywords": [
    "sfnt",
    "font",
    "editor",
    "ttf",
    "woff",
    "woff2",
    "svg",
    "eot",
    "otf"
  ],
  "homepage": "https://github.com/kekee000/fonteditor-core",
  "authors": [
    {
      "name": "kekee000",
      "email": "kekee000@gmail.com"
    },
    {
      "name": "junmer",
      "email": "junmer@foxmail.com"
    },
    {
      "name": "pumpkinzomb",
      "email": "pumpkinzomb@gmail.com"
    }
  ],
  "bugs": {
    "url": "https://github.com/kekee000/fonteditor-core/issues"
  },
  "licenses": [
    {
      "type": "MIT",
      "url": "https://github.com/kekee000/fonteditor-core/raw/master/LICENSE"
    }
  ],
  "scripts": {
    "precommit": "npm run lint",
    "publish:npm": "npm run build && npm publish --registry=https://registry.npmjs.org/",
    "test": "npm run test:browser && npm run test:node && npm run test:esm",
    "test:browser": "TS_NODE_PROJECT=tsconfig.test.json mocha --require ts-node/register --require tsconfig-paths/register --extension ts test/spec/*.spec.ts test/spec/**/*.spec.ts",
    "test:node": "npm run build && TS_NODE_PROJECT=tsconfig.test.json mocha --require ts-node/register --require tsconfig-paths/register --extension ts test/node-spec/**/*.spec.ts",
    "test:esm": "cd test/esm && npm i &&  mocha --extension mjs index.mjs",
    "test:example": "cd test/example && npm i && npm run test",
    "dev": "webpack-dev-server --open --config ./config/webpack.dev.js",
    "build": "npm run build:cjs && npm run build:esm",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json && echo '{\"type\":\"module\"}' > lib-esm/package.json",
    "clean": "rm -rf lib lib-esm",
    "lint": "eslint --ext .ts,.js ./src ./test",
    "lint:fix": "eslint --fix --ext .ts,.js ./src ./test"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{jsx,txs,ts,js,vue}": [
      "eslint"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/kekee000/fonteditor-core.git"
  },
  "files": [
    "index.d.ts",
    "lib",
    "lib-esm",
    "src",
    "woff2"
  ],
  "type": "commonjs",
  "main": "./lib/main.js",
  "module": "./lib-esm/main.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./lib-esm/main.js",
      "require": "./lib/main.js",
      "default": "./lib/main.js"
    },
    "./lib/*": "./lib/*.js",
    "./lib-esm/*": "./lib-esm/*.js"
  },
  "devDependencies": {
    "@babel/cli": "^7.20.7",
    "@babel/core": "^7.20.12",
    "@babel/preset-env": "^7.20.2",
    "@babel/register": "^7.18.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^16.18.126",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "babel-loader": "^8.0.6",
    "babel-plugin-module-resolver": "^4.1.0",
    "commander": "^3.0.2",
    "css-loader": "^3.2.0",
    "eslint": "^7.9.0",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.23.4",
    "html-webpack-plugin": "^3.2.0",
    "husky": "^4.3.0",
    "lint-staged": "^10.4.0",
    "mocha": "^10.8.2",
    "pako": "^1.0.10",
    "style-loader": "^1.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.4",
    "webpack": "^4.41.1",
    "webpack-cli": "^3.3.9",
    "webpack-dev-server": "^3.8.2"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.3"
  }
}
